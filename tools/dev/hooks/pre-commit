#!/bin/sh
# Blocks a commit that adds internal files, labels or secrets to the public tree (tests/test_public_tree.py) or private
# paths (tests/test_no_private_paths.py). Install once per clone: git config core.hooksPath tools/dev/hooks
cd "$(git rev-parse --show-toplevel)" || exit 1
python3 -m unittest -q tests/test_public_tree.py tests/test_no_private_paths.py || {
  echo "pre-commit: the public tree check failed (see above); experiment records and handovers belong outside this repository" >&2
  exit 1; }
