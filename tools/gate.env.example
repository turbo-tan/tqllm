# tools/gate.sh --env-file: the model files the model tests read. Copy, set the paths for this box, keep it outside
# the repository (one file per machine). A variable left unset makes its test report skipped or no-model.

# 27B decode / speculation tests (int8_features, sampled_topk1, ...)
TQLLM_TEST_MODEL=/path/to/Qwen3.8-27B-TQ_L.gguf
TQLLM_TEST_DRAFTER=/path/to/Qwen3.8-27B-DFlash2-TQ3.gguf
TQLLM_TEST_DRAFT_VOCAB=/path/to/atx_65536.txt

# tokenizer-gguf: the GGUF's embedded tokenizer must give the same ids as the model's tokenizer.tqtok
TQLLM_TOK_GGUF=/path/to/Qwen3.8-27B-TQ_L.gguf
TQLLM_TOK_TQTOK=/path/to/tokenizer.tqtok

# pplx-embed-model / embed-inputs: the 0.6B converted with --outtype auto (F32, as the checkpoint; the exact path is
# gated on min cosine >= 0.999 against the fp32 reference) and the fixture from the HF model (ids, spans, fp32 rows)
TQLLM_PPLX_GGUF=/path/to/pplx-embed-v2-context-0.6b-f32.gguf
TQLLM_PPLX_TOKENS=/path/to/fixture/gate_items.json
TQLLM_PPLX_REF=/path/to/fixture/ref_fp32.f32

# pplx-embed-model-fast: the served file (--outtype bf16: BF16 layers, F32 token table), gated on the fp32 tail rule
TQLLM_PPLX_FAST_GGUF=/path/to/pplx-embed-v2-context-0.6b-bf16.gguf

# hf_qwen4exp real-folder check: a Qwen4-exp Hugging Face folder and the GGUF converted from it. It has never run with a
# model in any gate of ours (no run set these, and the folder is gone); listed in TQLLM_GATE_NO_MODEL until it exists.
# TQLLM_TEST_HF_QWEN4EXP=/path/to/hf-folder
# TQLLM_TEST_REF_GGUF=/path/to/reference.gguf
TQLLM_GATE_NO_MODEL=hf_qwen4exp
