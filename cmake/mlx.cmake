if(NOT APPLE)
  message(FATAL_ERROR "TQLLM_MLX requires Apple Metal")
endif()
# a pip wheel build (scikit-build-core) finds MLX in the mlx / mlx-metal wheels of its build environment
if(SKBUILD AND NOT MLX_DIR)
  execute_process(COMMAND "${Python_EXECUTABLE}" -m mlx --cmake-dir OUTPUT_VARIABLE MLX_DIR OUTPUT_STRIP_TRAILING_WHITESPACE)
endif()
find_package(MLX 0.32 CONFIG REQUIRED)
# some MLX 0.32.x installs name jaccl::jaccl in the mlx link interface without loading its targets (issue #24)
if(NOT TARGET jaccl::jaccl AND MLX_DIR AND EXISTS "${MLX_DIR}/../jaccl/jacclTargets.cmake")
  include("${MLX_DIR}/../jaccl/jacclTargets.cmake")
endif()
enable_language(OBJCXX)
add_library(tqmlx STATIC src/backends/metal/tq4.cpp src/backends/metal/tq3.cpp src/backends/metal/q6.cpp src/backends/metal/q8.cpp
            src/backends/metal/q4_embedding.cpp src/backends/metal/weights.cpp src/backends/metal/kquant.cpp src/spec/draft_tree.cpp)
target_include_directories(tqmlx PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/src/backends/metal)
target_link_libraries(tqmlx PUBLIC mlx tqllm)
target_sources(tqmlx PRIVATE src/backends/metal/qwen35.cpp src/backends/metal/gdn.cpp src/backends/metal/dflash.cpp
               src/formats/weight/dequant.cpp src/backends/metal/draft_head.cpp src/backends/metal/prefill.cpp
               src/backends/metal/nax_affine.cpp src/backends/metal/prefill_fused.cpp src/backends/metal/ane_program.mm)
set_source_files_properties(src/backends/metal/ane_program.mm PROPERTIES COMPILE_FLAGS "-fobjc-arc")
target_link_libraries(tqmlx PUBLIC "-framework Foundation" "-framework Metal" "-framework IOSurface")
foreach(tool tqmlx-probe:tqmlx_probe tqmlx-dflash:tqmlx_dflash tqmlx-spec:tqmlx_spec tqmlx-ar:tqmlx_ar tqmlx-tree-bench:tqmlx_tree_bench tqmlx-qsa-bench:tqmlx_qsa_bench bench-mlx-sdpa:bench_mlx_sdpa
             bench-mlx-verify:bench_mlx_verify bench-mlx-prefill-gemm:bench_mlx_prefill_gemm bench-mlx-gdn-step:bench_mlx_gdn_step)
  string(REPLACE ":" ";" parts ${tool})
  list(GET parts 0 target)
  list(GET parts 1 source)
  add_executable(${target} tools/${source}.cpp)
  target_link_libraries(${target} PRIVATE tqmlx)
endforeach()
target_include_directories(tqmlx-dflash PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/tools)
if(BUILD_TESTING)
  # GPU tests run with TF32 off (exact FP32 references)
  foreach(test dense_rows tq4 gdn gdn_fuse prefill_fused gdn_scan8 gdn_fast decode_rows kv_int8_append kv_tcq kv_formats_model tree_verify tree_kernels tree_device attention_exact attention_qsa nax_affine dflash dflash_block dflash_retrieve dflash_selector dspine_bridge dflash_top16 sampling_topk sample_rows draft_ahead_math draft_head_rows kquant tq4_basis attention_rows)
    string(REPLACE "_" "-" name ${test})
    add_executable(test-mlx-${name} tests/mlx_${test}.cpp)
    target_link_libraries(test-mlx-${name} PRIVATE tqmlx)
    add_test(NAME mlx_${test} COMMAND test-mlx-${name})
    set_tests_properties(mlx_${test} PROPERTIES ENVIRONMENT "MLX_ENABLE_TF32=0")
  endforeach()
  set_tests_properties(mlx_tree_device PROPERTIES WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR})  # the 8K lattice fixture
  target_compile_definitions(test-mlx-kquant PRIVATE KQ_GOLDEN="${CMAKE_CURRENT_SOURCE_DIR}/tests/data/kquant_golden.bin")
  # model-file tests (run by hand with a GGUF path)
  foreach(test prefix mtp draft_head)
    string(REPLACE "_" "-" name ${test})
    add_executable(test-mlx-${name} tests/mlx_${test}.cpp)
    target_link_libraries(test-mlx-${name} PRIVATE tqmlx)
  endforeach()
  # the private-API Neural Engine FFN program, driven from the CPU (Objective-C++ with ARC; run by hand on a Mac)
  add_executable(test-mlx-ane-program tests/mlx_ane_program.cpp)
  set_source_files_properties(tests/mlx_ane_program.cpp PROPERTIES COMPILE_FLAGS "-fobjc-arc -x objective-c++")
  target_link_libraries(test-mlx-ane-program PRIVATE tqmlx "-framework Foundation" "-framework Metal" "-framework IOSurface")
  add_executable(test-mlx-nax-tiles tests/mlx_nax_tiles.cpp)
  set_source_files_properties(tests/mlx_nax_tiles.cpp PROPERTIES COMPILE_FLAGS "-fobjc-arc -x objective-c++")
  target_link_libraries(test-mlx-nax-tiles PRIVATE tqmlx "-framework Foundation" "-framework Metal")
  add_executable(test-mlx-attn-decode-bench tests/mlx_attn_decode_bench.cpp)
  set_source_files_properties(tests/mlx_attn_decode_bench.cpp PROPERTIES COMPILE_FLAGS "-fobjc-arc -x objective-c++")
  target_link_libraries(test-mlx-attn-decode-bench PRIVATE tqmlx "-framework Foundation" "-framework Metal")
  foreach(test release_defaults sampling wired_budget width_policy kv_capacity tcq_codec kv_tier)
    string(REPLACE "_" "-" name ${test})
    add_executable(test-mlx-${name} tests/mlx_${test}.cpp)
    target_include_directories(test-mlx-${name} PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/src/backends/metal)
    add_test(NAME mlx_${test} COMMAND test-mlx-${name})
  endforeach()
  add_executable(test-mlx-env-flags tests/mlx_env_flags.cpp)
  target_link_libraries(test-mlx-env-flags PRIVATE tqllm)
  add_test(NAME mlx_env_flags COMMAND python3 ${CMAKE_CURRENT_SOURCE_DIR}/tests/mlx_env_flags.py $<TARGET_FILE:test-mlx-env-flags>)
endif()

# tqserve on the MLX backend (Apple Silicon): the shared HTTP server over the shared tqllm::Model (src/engine/model.cpp),
# which picks the Metal engine (src/backends/metal/engine_mlx.cpp) through the registry (builtin_mlx.cpp)
if(NOT TQLLM_COMMIT)
  file(STRINGS ${CMAKE_CURRENT_SOURCE_DIR}/src/COMMIT TQLLM_COMMIT LIMIT_COUNT 1)
  if(NOT TQLLM_COMMIT OR TQLLM_COMMIT MATCHES "Format")
    execute_process(COMMAND git -C ${CMAKE_CURRENT_SOURCE_DIR} rev-parse --short HEAD
                    OUTPUT_VARIABLE TQLLM_COMMIT OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  endif()
  if(NOT TQLLM_COMMIT)
    set(TQLLM_COMMIT "unknown")
  endif()
endif()
add_executable(tqserve tools/tqserve.cpp src/engine/model.cpp src/engine/registry.cpp src/backends/metal/engine_mlx.cpp
               src/backends/metal/builtin_mlx.cpp src/core/gguf_mapped.cpp)
target_include_directories(tqserve PRIVATE ${CMAKE_CURRENT_SOURCE_DIR} ${CMAKE_CURRENT_SOURCE_DIR}/tools ${CMAKE_CURRENT_SOURCE_DIR}/src ${CMAKE_CURRENT_BINARY_DIR}/generated)
target_link_libraries(tqserve PRIVATE tqmlx tqllm tqjinja Threads::Threads)
target_compile_definitions(tqserve PRIVATE TQLLM_COMMIT="${TQLLM_COMMIT}")

# pip wheel (pyproject.toml, scikit-build-core): tqserve inside the tqllm package, linked to the mlx package's libmlx
if(SKBUILD)
  set_target_properties(tqserve PROPERTIES INSTALL_RPATH "@loader_path/../../mlx/lib")
  install(TARGETS tqserve RUNTIME DESTINATION tqllm/bin COMPONENT wheel)
endif()
