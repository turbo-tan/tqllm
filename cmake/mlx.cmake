if(NOT APPLE)
  message(FATAL_ERROR "TQLLM_MLX requires Apple Metal")
endif()
find_package(MLX 0.32 CONFIG REQUIRED)
add_library(tqmlx STATIC src/mlx/tq4.cpp src/mlx/tq3.cpp src/mlx/tq3_expanded.cpp src/mlx/q6.cpp src/mlx/q8.cpp src/mlx/q4_embedding.cpp src/mlx/weights.cpp)
target_include_directories(tqmlx PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/src/mlx)
target_link_libraries(tqmlx PUBLIC mlx tqllm)
target_sources(tqmlx PRIVATE src/mlx/qwen35.cpp src/mlx/gdn.cpp)
