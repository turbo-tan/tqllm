+std::vector<array> scaled_dot_product_attention_lse(
+    const array& queries,
+    const array& keys,
+    const array& values,
+    const float scale,
+    const array& mask,
+    StreamOrDevice s /* = {} */) {
+  for (const auto& tensor : {queries, keys, values, mask}) {
+    if (tensor.ndim() != 4) {
+      throw std::invalid_argument(
+          "[scaled_dot_product_attention_lse] queries, keys, values and mask must be 4D.");
+    }
+  }
+  if (mask.dtype() != bool_) {
+    throw std::invalid_argument("[scaled_dot_product_attention_lse] the mask must be bool.");
+  }
+  auto final_type = result_type(queries, keys, values);
+  auto stream = to_stream(s);
+  auto q = astype(queries, final_type, stream);
+  auto k = astype(keys, final_type, stream);
+  auto v = astype(values, final_type, stream);
+  auto mask_shape = q.shape();
+  mask_shape.back() = k.shape(-2);
+  std::vector<array> inputs = {q, k, v, broadcast_to(mask, mask_shape, stream)};
+  // force_fused: throws when no fused kernel can produce the log-sum-exp
+  ScaledDotProductAttention::use_fallback(
+      q, k, v, true, true, false, false, true, true, stream);
+  if (!ScaledDotProductAttention::supports_bool_mask()) {
+    float inf = std::numeric_limits<float>::infinity();
+    inputs[3] = where(
+        inputs[3],
+        full_like(inputs[3], 0, final_type, stream),
+        full_like(inputs[3], -inf, final_type, stream),
+        stream);
+  }
+  auto fallback = [](const std::vector<array>&) -> std::vector<array> {
+    throw std::runtime_error("[scaled_dot_product_attention_lse] no fallback");
+  };
+  auto primitive = std::make_shared<ScaledDotProductAttention>(
+      stream, fallback, scale, false, false, true, true);
+  return array::make_arrays(
+      {Shape{q.shape(0), q.shape(1), q.shape(2), v.shape(-1)},
+       Shape{q.shape(0), q.shape(1), q.shape(2), 1}},
+      {final_type, float32},
+      primitive,
+      std::move(inputs));
+}
